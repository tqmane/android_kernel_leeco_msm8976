# Docker/container support fragment for LeEco Le 2 (s2)
#
# This is merged on top of lineage_s2_defconfig by the manual GitHub
# Actions workflow. Keep the base LineageOS defconfig untouched so normal
# LineageOS builds retain their original configuration.
#
# IMPORTANT: this is the Android 11 boot-safe profile. The s2 3.10 tree has
# incomplete/dormant CPUSET and MEMCG backports; enabling them required source
# rewriting and produced a kernel that builds but does not boot Android 11
# correctly. Keep those controllers disabled until they are properly backported.

# IPC / namespaces
CONFIG_SYSVIPC=y
CONFIG_FHANDLE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# cgroup v1 controllers that are safe on the stock s2 3.10 code paths.
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y

# Do not enter the known-broken legacy source paths on the default Docker build.
# A proper backport is required before re-enabling these.
# CONFIG_CPUSETS is not set
# CONFIG_MEMCG is not set
# CONFIG_MEMCG_KMEM is not set
# CONFIG_MEMCG_SWAP is not set
# CONFIG_MEMCG_SWAP_ENABLED is not set

# Required for separate /dev/pts instances on kernels older than 4.8
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y

# Container networking
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_NEEDED=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y

# IPv6 container networking/NAT
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_NF_NAT_IPV6=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# IPVS support used by Docker Swarm and some container networking setups
CONFIG_IP_VS=y
CONFIG_IP_VS_IPV6=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_NFCT=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y

# Runtime isolation
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Useful optional cgroup/network controls that do not enter the broken
# CPUSET/MEMCG source paths.
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_PERF=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NETPRIO_CGROUP=y
